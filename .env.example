# Database (PostgreSQL - Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/addis_barber?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/addis_barber?schema=public"

# Timezone (Addis Ababa, East Africa Time UTC+3)
TZ="Africa/Addis_Ababa"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notifications - Email (Resend)
RESEND_API_KEY="re_sample_key_replace_with_actual"
EMAIL_FROM="Arada Barbershop <booking@arada-barber.et>"

# Notifications - Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_SHOP_CHAT_ID=""

# Notifications - SMS (Optional / Swappable)
SMS_PROVIDER="mock" # options: "mock", "africastalking", "twilight"
SMS_API_KEY=""

# Admin Dashboard
ADMIN_PASSWORD="admin_change_this_in_production"
ADMIN_SESSION_SECRET="super-secret-session-key-32-chars-long"

